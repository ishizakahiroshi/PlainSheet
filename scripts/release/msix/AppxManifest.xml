<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft Store MSIX package manifest.

  Identity values must match the values assigned in Partner Center exactly
  (Product management > Product identity). They are not secrets: every
  published package carries them.
  {{VERSION}} is replaced by build-msix.ps1 with the release version converted
  from X.Y.Z to X.Y.Z.0 (the fourth field is reserved by the Store).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="ishizakahiroshi.PlainSheet"
    Publisher="CN=A454C7F3-0506-42C1-AB41-2BE056B76ABF"
    Version="{{VERSION}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>PlainSheet</DisplayName>
    <PublisherDisplayName>ishizakahiroshi</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- Windows 11 21H2 or later; the Store edition relies on the Evergreen WebView2 Runtime. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <!-- The languages the app's interface is translated into. The Store asks for a listing in each. -->
  <Resources>
    <Resource Language="en-us" />
    <Resource Language="ja-jp" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="PlainSheet.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="PlainSheet"
        Description="Plain text table editor for CSV, TSV, Markdown tables, JSON and YAML"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Square71x71Logo="Assets\Square71x71Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Same file types as bundle.fileAssociations in src-tauri/tauri.conf.json. -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="plaintexttable">
            <uap:DisplayName>Plain text table</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.csv</uap:FileType>
              <uap:FileType>.tsv</uap:FileType>
              <uap:FileType>.md</uap:FileType>
              <uap:FileType>.markdown</uap:FileType>
              <uap:FileType>.json</uap:FileType>
              <uap:FileType>.yaml</uap:FileType>
              <uap:FileType>.yml</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
