# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.idea/
.vscode/

# Local environment
.env
.env.*
!.env.example
*.local.md
*.local.json
docs/local/

# AI assistant local state
.claude/
# many-ai-cli writes these into the working folder only while an opencode session
# runs (opencode.json.many-ai-cli.lock is the exclusive lock). A killed session
# leaves them behind; the prefix match is needed to catch the lock as well.
opencode.json*

# Dependency and build output
node_modules/
dist/
build/
.cache/
coverage/
src-tauri/target/

# Python cache
__pycache__/
*.py[cod]
.pytest_cache/

# Logs and scratch artifacts
*.log
*.jsonl
*.tmp
*.bak
*.orig
*.rej

# Local-only files (*.local.md / *.local.json are listed individually above; cover the rest)
*.local
*.local.*

# --- Credentials / secrets / keys (never push to a public repo) ---
*.pem
*.key
*.p12
*.pfx
*.ppk
id_rsa
id_dsa
id_ecdsa
id_ed25519
secrets.*
*.secret.*
*credential*
.netrc
.npmrc
.pypirc

# docsweep: backup snapshots (30-day retention, auto-cleanup)
.docsweep/
# === obsidian-link: managed ===
/docs/obsidian/
# === /obsidian-link: managed ===
